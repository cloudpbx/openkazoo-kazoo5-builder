# syntax=docker/dockerfile:1.6
# Build image for EL9 (Rocky 9 / Alma 9 / RHEL 9) packages.
#
# OTP is compiled from source via kerl rather than from
# packages.erlang-solutions.com (which was retired in mid-2026) or
# binaries2.erlang-solutions.com (which has no Rocky 9 builds at all,
# only Rocky 8). kazoo5 pins OTP 26.2 per make/erlang_version, so we
# build that exact version. relx's tar-release bundles ERTS into the
# resulting tarball, so the produced .rpm has no Erlang runtime
# dependency on the host.

FROM rockylinux:9

ARG OTP_VERSION=26.2.5
ARG REBAR_VERSION=3.23.0
# SHA-256 pins for the network-fetched artifacts. Defaulted here (like the
# version args above) and overridden by the Makefile from config/*.sha256 so
# both `make docker-build` and a bare `docker build` verify the downloads.
# These MUST track OTP_VERSION / REBAR_VERSION when either is bumped.
ARG OTP_SHA256=de155c4ad9baab2b9e6c96dbd03bf955575a04dd6feee9c08758beb28484c9f6
ARG REBAR_SHA256=195591a13abf6a337aecbbc4c9b33d3684b0f3b14c76e84c007baff38db20393

# Toolchain: development tools, packaging utilities, Erlang/OTP build
# dependencies (no GUI/WX; that'd require X11 libs).
# curl-minimal ships in the base image and is sufficient for our needs;
# do NOT install full curl (conflicts with curl-minimal on Rocky 9).
RUN dnf -y install dnf-plugins-core \
 && dnf -y install epel-release \
 && dnf config-manager --set-enabled crb \
 && dnf -y groupinstall "Development Tools" \
 && dnf -y install \
      ca-certificates wget git openssh-clients make \
      autoconf zip unzip libxslt \
      openssl-devel ncurses-devel \
      lksctp-tools-devel \
      wxGTK3-devel \
      python3 ruby ruby-devel rubygems \
      createrepo_c rpm-sign gnupg2 \
 && dnf clean all

# kazoo5 fetches some applications via SSH URLs (git@github.com:2600hz/...).
# Rewrite SSH GitHub URLs to HTTPS globally (public repos, no creds needed).
RUN git config --global url."https://github.com/".insteadOf "git@github.com:" \
 && git config --global url."https://github.com/".insteadOf "ssh://git@github.com/"

# Build OTP from source directly (no kerl). Plain
# ./configure && make && make install gives full diagnostic output.
RUN set -ex \
 && curl -fsSL --retry 5 --retry-delay 5 --retry-all-errors \
      "https://github.com/erlang/otp/releases/download/OTP-${OTP_VERSION}/otp_src_${OTP_VERSION}.tar.gz" \
      -o /tmp/otp.tar.gz \
 && echo "${OTP_SHA256}  /tmp/otp.tar.gz" | sha256sum -c - \
 && mkdir -p /tmp/otp_build \
 && tar -xzf /tmp/otp.tar.gz -C /tmp/otp_build --strip-components=1 \
 && rm /tmp/otp.tar.gz \
 && cd /tmp/otp_build \
 && ./configure \
      --prefix="/opt/erlang/${OTP_VERSION}" \
      --disable-debug \
      --disable-silent-rules \
      --without-javac \
      --without-jinterface \
      --without-megaco \
      --without-et \
      --without-odbc \
      --enable-threads \
      --enable-shared-zlib \
      --enable-ssl=dynamic-ssl-lib \
      --enable-smp-support \
      --enable-kernel-poll \
      --enable-dynamic-ssl-lib \
 && make -j"$(nproc)" \
 && make install \
 && cd / && rm -rf /tmp/otp_build \
 && ln -s "/opt/erlang/${OTP_VERSION}/bin/erl"     /usr/local/bin/erl  \
 && ln -s "/opt/erlang/${OTP_VERSION}/bin/erlc"    /usr/local/bin/erlc \
 && ln -s "/opt/erlang/${OTP_VERSION}/bin/escript" /usr/local/bin/escript \
 && erl -version

# rebar3
RUN curl -fsSL --retry 5 --retry-delay 5 --retry-all-errors \
      "https://github.com/erlang/rebar3/releases/download/${REBAR_VERSION}/rebar3" \
      -o /usr/local/bin/rebar3 \
 && echo "${REBAR_SHA256}  /usr/local/bin/rebar3" | sha256sum -c - \
 && chmod +x /usr/local/bin/rebar3 \
 && rebar3 --version

# FPM
RUN gem install --no-document fpm:1.16.0

ENV PATH="/opt/erlang/${OTP_VERSION}/bin:${PATH}"

WORKDIR /work
ENTRYPOINT ["/work/scripts/build.sh"]
