# /etc/default/kazoo
# Environment for the kazoo systemd service.
# Edit this file to customize. Marked as a conffile / %config(noreplace);
# package upgrades will not overwrite your changes.

# Erlang node short name for this host. Must be unique per cluster member.
NODE_NAME=kazoo_apps@127.0.0.1

# Erlang distribution cookie.
# On first install the post-install scriptlet generates a strong random cookie
# into /etc/kazoo.cookie (mode 0640, root:kazoo) — this file is NOT overwritten
# on upgrade. That per-host default is fine for a single node.
#
# For a MULTI-NODE CLUSTER, every member must share the SAME cookie: set it
# here (this line overrides the generated one) and copy the identical value to
# each node.
#COOKIE=set-a-strong-shared-secret-for-clusters

# Additional Erlang VM flags (e.g. memory limits).
ERL_FLAGS=""
