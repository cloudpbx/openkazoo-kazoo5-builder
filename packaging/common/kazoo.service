[Unit]
Description=Kazoo telephony platform
Documentation=https://github.com/cloudpbx/openkazoo-kazoo5-builder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kazoo
Group=kazoo
# The auto-generated distribution cookie (written by the post-install
# scriptlet on first install) is read first; /etc/default/kazoo is read second
# so an operator who sets COOKIE there — e.g. a shared cluster cookie —
# overrides the generated per-host default.
EnvironmentFile=-/etc/kazoo.cookie
EnvironmentFile=-/etc/default/kazoo
WorkingDirectory=/var/lib/kazoo
# 'foreground' is the relx-supplied non-daemonizing entrypoint; systemd
# supervises the BEAM VM directly and journald captures stdout/stderr.
# Avoid 'bin/kazoo start' (Type=forking) because relx doesn't write a PIDFile
# in a systemd-discoverable location, leading to misleading service state.
ExecStart=/opt/kazoo/bin/kazoo foreground
# systemd sends SIGTERM on stop; relx handles it as graceful shutdown.
Restart=on-failure
RestartSec=10s
LimitNOFILE=65535
# Hardening (conservative defaults; tighten in a later phase)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
